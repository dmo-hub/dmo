# ============================================================
# Yggdrasil System — ตัวอย่างไฟล์ตั้งค่า
# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (ห้าม commit .env)
#
#   bot หลัก   ใช้:  BOT_DISCORD_TOKEN + BUS_CHANNEL_ID + SHARED_SECRET (+ GUILD_ID, ALLOWED_IDS)
#   agent      ใช้:  AGENT_DISCORD_TOKEN + BUS_CHANNEL_ID + SHARED_SECRET + MACHINE_ID + DATS_DIR
# ============================================================

# ---- ใช้ร่วมทั้งสองฝั่ง ----
# id ของ channel ลับที่ใช้รับส่งคำสั่ง (เปิด Developer Mode ใน Discord แล้วคลิกขวา channel > Copy ID)
BUS_CHANNEL_ID=000000000000000000
# รหัสลับใด ๆ ที่ตั้งเอง ต้องเหมือนกันทั้ง bot และ agent (กันคนปลอมส่งคำสั่ง)
SHARED_SECRET=เปลี่ยนเป็นรหัสลับยาว ๆ ของคุณ

# ---- ฝั่ง bot หลัก ----
BOT_DISCORD_TOKEN=
# guild (server) id — ใส่ระหว่างพัฒนาเพื่อให้ slash command โผล่ทันที (เว้นว่าง = global ~1ชม.)
GUILD_ID=
# user id หรือ role id ที่อนุญาตให้สั่งบอท คั่นด้วยคอมมา (เว้นว่าง = ทุกคนสั่งได้ ไม่แนะนำ)
ALLOWED_IDS=

# ---- ฝั่ง agent (เครื่องเกม) ----
AGENT_DISCORD_TOKEN=
# ชื่อเครื่องนี้ ไม่ซ้ำกับเครื่องอื่น (เว้นว่าง = ใช้ชื่อคอมพิวเตอร์)
MACHINE_ID=GAME-PC-1
# โฟลเดอร์ที่มี dats.exe / config.ini / screenshot.bmp / error.txt
DATS_DIR=C:\Vplay\DigimonMastersOnline(Tailand)\DATS
# (ออปชัน) ระบุ path แยกถ้าไม่ได้อยู่ใน DATS_DIR
# DATS_EXE=
# CONFIG_INI=
# SCREENSHOT_BMP=
# ERROR_TXT=
